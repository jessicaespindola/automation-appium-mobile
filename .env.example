# Opcional. Se omitido, o WDIO usa %LOCALAPPDATA%\Android\Sdk
# ANDROID_HOME=
# ANDROID_SDK_ROOT=

# Obrigatório. JDK usado pelo Appium e pelo Allure CLI.
# JAVA_HOME=C:\Program Files\Microsoft\jdk-17

# Nome do device/AVD. Confira com: adb devices
ANDROID_DEVICE_NAME=Android Emulator
# ANDROID_PLATFORM_VERSION=11.0
# ANDROID_UDID=emulator-5554

APPIUM_PORT=4730

# warn | info | debug
LOG_LEVEL=warn

# Abrir o HTML do Allure ao fim da suíte (true|false)
ALLURE_OPEN=true

# Define o locale do aparelho. Use no emulador; isso altera o idioma do device.
# ANDROID_LANGUAGE=en
# ANDROID_LOCALE=US

# true só depois da primeira sessão bem-sucedida neste device.
# Pula a reinstalação do servidor UiAutomator2.
# APPIUM_SKIP_SERVER_INSTALL=true

# Grava a tela de cada teste e anexa o vídeo no Allure apenas em falha.
# RECORD_VIDEO=true
