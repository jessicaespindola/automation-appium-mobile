{
  "name": "appium-mobile-automation",
  "version": "1.0.0",
  "description": "Automação mobile Android com Appium 2 + WebdriverIO (Native Demo App)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/install-driver.mjs",
    "test": "wdio run config/wdio.android.conf.ts",
    "test:login": "wdio run config/wdio.android.conf.ts --spec=test/specs/login.spec.ts",
    "test:forms": "wdio run config/wdio.android.conf.ts --spec=test/specs/forms.spec.ts",
    "test:navigation": "wdio run config/wdio.android.conf.ts --spec=test/specs/navigation.spec.ts",
    "report:generate": "allure generate reports/allure-results -o reports/allure-report --clean",
    "report:open": "node scripts/serve-allure.mjs reports/allure-report",
    "report": "npm run report:generate && npm run report:open",
    "app:download": "node scripts/download-apk.mjs",
    "appium:setup": "node scripts/install-driver.mjs",
    "appium:doctor": "node scripts/appium-cli.mjs driver doctor uiautomator2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@wdio/allure-reporter": "^9.22.0",
    "@wdio/appium-service": "^9.22.0",
    "@wdio/cli": "^9.22.0",
    "@wdio/globals": "^9.22.0",
    "@wdio/local-runner": "^9.22.0",
    "@wdio/mocha-framework": "^9.22.0",
    "@wdio/spec-reporter": "^9.20.0",
    "allure-commandline": "^2.34.1",
    "appium": "^2.19.0",
    "dotenv": "^16.5.0",
    "expect-webdriverio": "^6.0.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
